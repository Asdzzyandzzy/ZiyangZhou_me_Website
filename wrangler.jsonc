{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziyangzhouwebsite",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-05-11",
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
